# MongoDB - private server configuration
MONGODB_URL=mongodb://root:changeMe@127.0.0.1:27038/nfz_daisyui?authSource=admin

# Redis - private server configuration. Never expose this URL in runtimeConfig.public.
REDIS_ENABLED=true
REDIS_URL=redis://127.0.0.1:6380/0
REDIS_PREFIX=nfz:daisyui
REDIS_CACHE_TTL_SECONDS=60

# Demo user. Keep demo seeding disabled in production unless you provide a strong password.
NFZ_DEMO_ENABLED=true
NFZ_DEMO_USER=admin
NFZ_DEMO_PASSWORD=admin123
NFZ_DEMO_ROLES=admin,member
