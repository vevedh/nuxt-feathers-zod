# Optional external MongoDB used only when external mode is explicitly selected.
# Auto mode intentionally ignores MONGODB_URL and provisions an isolated test instance.
# MONGODB_URL=mongodb://user:secret@127.0.0.1:27017/nfz_release?authSource=admin
# NFZ_STARTER_RELEASE_MONGODB_MODE=auto # auto | external | memory

# Strictly validate the generated authentication setup during prepare.
NFZ_AUTH_PREPARE_STRICT=true
