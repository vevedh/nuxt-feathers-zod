# Optional external MongoDB used only when external mode is explicitly selected.
# Auto mode intentionally ignores MONGODB_URL and provisions an isolated test instance.
# MONGODB_URL=mongodb://user:secret@127.0.0.1:27017/nfz_release?authSource=admin
# NFZ_STARTER_RELEASE_MONGODB_MODE=auto # auto | external | memory

# Strictly validate the generated authentication setup during prepare.
NFZ_AUTH_PREPARE_STRICT=true

# Optional external SQL engines for Patch 067 release certification.
# When unset, the release gate provisions isolated Docker containers.
# NFZ_MYSQL_CERTIFICATION_URL=mysql://root:secret@127.0.0.1:3306/nfz_cert
# NFZ_MARIADB_CERTIFICATION_URL=mysql://root:secret@127.0.0.1:3306/nfz_cert
# NFZ_MYSQL_DOCKER_IMAGE=mysql:8.4
# NFZ_MARIADB_DOCKER_IMAGE=mariadb:11.8


# Optional Microsoft SQL Server engine for Patch 069 certification.
# When the JSON connection is unset, the gate provisions an isolated SQL Server 2025 container.
# NFZ_MSSQL_DOCKER_IMAGE=mcr.microsoft.com/mssql/server:2025-CU8-ubuntu-22.04
# NFZ_MSSQL_CERTIFICATION_CONNECTION_JSON=

# Optional image overrides for Patch 070 cross-database coexistence certification.
# The gate inspects/pulls these images explicitly before docker run to avoid implicit-pull timeouts.
# NFZ_MATRIX_MONGODB_DOCKER_IMAGE=mongo:7.0
# NFZ_MATRIX_POSTGRESQL_DOCKER_IMAGE=postgres:18-alpine

# Optional exact-candidate consumer install resilience.
# Shared by PostgreSQL, MySQL/MariaDB, SQLite, MSSQL and database-matrix certification consumers.
# Defaults: 900000 ms (15 min) per attempt and 2 attempts. Database fixtures use Bun with
# --omit=peer, copyfile/hoisted materialization and network concurrency backoff; the clean Nuxt
# consumer remains the separate npm compatibility proof.
# NFZ_RELEASE_CONSUMER_INSTALL_TIMEOUT_MS=900000
# NFZ_RELEASE_CONSUMER_INSTALL_ATTEMPTS=2
# NFZ_RELEASE_CONSUMER_NETWORK_CONCURRENCY=8
# NFZ_RELEASE_CONSUMER_INSTALL_RETRY_DELAY_MS=2000

# Optional documentation bundle observability. The 500 KiB soft threshold is informational.
# Set a positive hard limit only after measuring the current generated asset baseline.
# NFZ_DOCS_BUNDLE_SOFT_BYTES=512000
# NFZ_DOCS_BUNDLE_MAX_BYTES=0
