# Optional external MongoDB used by the full NFZ release gate.
# In auto mode, an unreachable or absent URL falls back to an isolated test instance.
MONGODB_URL=mongodb://127.0.0.1:27017/nfz_release
# NFZ_STARTER_RELEASE_MONGODB_MODE=auto # auto | external | memory

# Strictly validate the generated authentication setup during prepare.
NFZ_AUTH_PREPARE_STRICT=true
